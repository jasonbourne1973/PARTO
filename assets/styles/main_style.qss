/* ============================================================
   تم سراسری PARTOW - آبی تیره، زرد طلایی و سبز
   هیچ رنگ سفید خالصی در این فایل استفاده نشده است.
   ============================================================ */

/* ===== تنظیمات عمومی ===== */
QWidget {
    font-family: "Vazirmatn";
    font-size: 13px;
    color: #F4C542;
}

QMainWindow {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #061B2D,
        stop: 0.30 #0B2E4F,
        stop: 0.58 #123F64,
        stop: 0.78 #174F78,
        stop: 1 #08223A
    );
}

/* ===== منوی سمت چپ؛ بدون تغییر در پالت قبلی ===== */
QFrame#MenuFrame {
    background-color: #0B2E4F;
    border: none;
}

QPushButton[class="MenuButton"] {
    background-color: transparent;
    color: #F4C542;
    border: none;
    border-radius: 0px;
    padding: 12px 16px;
    text-align: right;
    font-weight: 500;
    font-size: 13px;
    min-height: 40px;
    margin: 2px 0px;
}

QPushButton[class="MenuButton"]:hover {
    background-color: #174F78;
    color: #FFE8A3;
    border-right: 3px solid #F4C542;
}

QPushButton[class="MenuButton"]:checked,
QPushButton[class="MenuButton"]:pressed {
    background-color: #08223A;
    color: #FFE8A3;
    border-right: 3px solid #F4C542;
}

QPushButton[class="MenuButton"]:disabled {
    color: #D9C36A;
    background-color: transparent;
}

QPushButton#btnLogout {
    background-color: #C62828;
    color: #111111;
    border: none;
    border-top: 1px solid #F28C28;
    padding: 12px 16px;
    text-align: right;
    font-weight: bold;
    font-size: 13px;
    min-height: 40px;
}

QPushButton#btnLogout:hover {
    background-color: #F28C28;
    color: #111111;
}

/* ===== دکمه‌ها ===== */
QPushButton {
    border: 1px solid #D9C36A;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    min-height: 32px;
    background-color: #0B2E4F;
    color: #F4C542;
}

QPushButton:hover {
    background-color: #174F78;
    color: #FFE8A3;
}

QPushButton:disabled {
    background-color: #08223A;
    color: #D9C36A;
    border-color: #526170;
}

QPushButton[class="btn-primary"] {
    background-color: #174F78;
    color: #F4C542;
    border: 1px solid #D9C36A;
}
QPushButton[class="btn-primary"]:hover {
    background-color: #2A6796;
    color: #FFE8A3;
}

QPushButton[class="btn-success"] {
    background-color: #66BB6A;
    color: #111111;
    border-color: #8BC34A;
}
QPushButton[class="btn-success"]:hover {
    background-color: #8BC34A;
    color: #111111;
}

QPushButton[class="btn-warning"] {
    background-color: #F4D35E;
    color: #C62828;
    border-color: #D9C36A;
}
QPushButton[class="btn-warning"]:hover {
    background-color: #FFE8A3;
    color: #C62828;
}

QPushButton[class="btn-danger"] {
    background-color: #F28C28;
    color: #111111;
    border-color: #F4D35E;
}
QPushButton[class="btn-danger"]:hover {
    background-color: #FFAA45;
    color: #111111;
}

/* ===== کادرها و کارت‌ها ===== */
QFrame[class="Card"],
QGroupBox {
    background-color: #66BB6A;
    color: #111111;
    border: 1px solid #8BC34A;
    border-radius: 8px;
    padding: 10px;
}

QFrame[class="Card"]:hover {
    background-color: #8BC34A;
    border-color: #F4C542;
}

QGroupBox::title {
    subcontrol-origin: margin;
    color: #111111;
    background-color: #8BC34A;
    padding: 0 8px;
}

/* ===== جدول‌ها: همه یکسان ===== */
QTableWidget,
QTreeWidget {
    background-color: #0B2E4F;
    color: #F4C542;
    border: 1px solid #D9C36A;
    border-radius: 6px;
    gridline-color: #D9C36A;
    selection-background-color: #66BB6A;
    selection-color: #F4C542;
}

QTableWidget::item,
QTreeWidget::item {
    background-color: #0B2E4F;
    color: #F4C542;
    padding: 6px;
    border-bottom: 1px solid #D9C36A;
}

QTableWidget::item:hover,
QTreeWidget::item:hover {
    background-color: #174F78;
    color: #FFE8A3;
}

QTableWidget::item:selected,
QTreeWidget::item:selected {
    background-color: #66BB6A;
    color: #F4C542;
}

QHeaderView::section,
QTreeWidget::header {
    background-color: #66BB6A;
    color: #111111;
    padding: 8px 12px;
    border: 1px solid #D9C36A;
    font-weight: bold;
}

QTreeWidget::branch {
    background-color: #0B2E4F;
}

/* ===== تب‌ها ===== */
QTabWidget::pane {
    background-color: #66BB6A;
    color: #111111;
    border: 1px solid #8BC34A;
    border-radius: 6px;
    padding: 8px;
}

QTabBar::tab {
    padding: 10px 20px;
    font-weight: bold;
    background-color: #66BB6A;
    color: #111111;
    border: 1px solid #8BC34A;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #8BC34A;
    border-color: #F4C542;
    border-bottom: 2px solid #F4C542;
    color: #111111;
}

QTabBar::tab:hover {
    background-color: #F4D35E;
    color: #111111;
}

/* ===== ورودی‌ها ===== */
QComboBox,
QLineEdit,
QSpinBox,
QDateEdit,
QTextEdit {
    padding: 6px 12px;
    border: 1px solid #8BC34A;
    border-radius: 6px;
    background-color: #08223A;
    color: #F4C542;
    min-height: 32px;
}

QComboBox:hover,
QLineEdit:hover,
QSpinBox:hover,
QDateEdit:hover,
QTextEdit:hover {
    border-color: #F4C542;
    background-color: #0B2E4F;
}

QComboBox:focus,
QLineEdit:focus,
QSpinBox:focus,
QDateEdit:focus,
QTextEdit:focus {
    border: 2px solid #F4C542;
    background-color: #0B2E4F;
    color: #FFE8A3;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #F4C542;
}

QComboBox QAbstractItemView {
    background-color: #08223A;
    color: #F4C542;
    selection-background-color: #66BB6A;
    selection-color: #111111;
    border: 1px solid #D9C36A;
}

/* ===== نوار پیشرفت ===== */
QProgressBar {
    background-color: #08223A;
    color: #F4C542;
    border: 1px solid #D9C36A;
    border-radius: 5px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #66BB6A;
    border-radius: 4px;
}

/* ===== Scrollbar ===== */
QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #061B2D;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar:vertical {
    width: 8px;
}

QScrollBar:horizontal {
    height: 8px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #8BC34A;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #F4C542;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
}

/* ===== اعلان، اخطار و هشدار ===== */
QMessageBox,
QMessageBox QWidget,
QDialog[role="warning"] {
    background-color: #F4D35E;
    color: #C62828;
}

QMessageBox QLabel,
QLabel[class="warning"],
QLabel[class="alert"],
QLabel[class="error"] {
    background-color: #F4D35E;
    color: #C62828;
}

QMessageBox QPushButton {
    background-color: #F4D35E;
    color: #C62828;
    border: 1px solid #C62828;
}

QLabel#NotificationBadge {
    background-color: #F4D35E;
    color: #C62828;
    border: 1px solid #C62828;
    border-radius: 10px;
    font-weight: bold;
    font-size: 10px;
    padding: 0px;
}

QToolTip {
    background-color: #F4D35E;
    color: #C62828;
    border: 1px solid #C62828;
    padding: 5px;
}

/* ===== پس‌زمینه محتوای اصلی ===== */
QWidget#MainContainer {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #061B2D,
        stop: 0.35 #0B2E4F,
        stop: 0.70 #123F64,
        stop: 1 #08223A
    );
}
