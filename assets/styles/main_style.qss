/* ============================================================
   استایل اصلی برنامه PARTO — مرجع نسخه قدیمی
   ============================================================ */

QWidget {
    font-family: "Vazirmatn";
    font-size: 13px;
}

QMainWindow { background-color: #f8f9fa; }

QFrame#MenuFrame { background-color: #2c3e50; border: none; }

QPushButton[class="MenuButton"] {
    background-color: transparent;
    color: #ecf0f1;
    border: none;
    border-radius: 0px;
    padding: 12px 16px;
    text-align: left;
    font-weight: 500;
    font-size: 13px;
    min-height: 40px;
    margin: 2px 0px;
}
QPushButton[class="MenuButton"]:hover {
    background-color: #34495e;
    border-right: 3px solid #3498db;
}
QPushButton[class="MenuButton"]:checked,
QPushButton[class="MenuButton"]:pressed {
    background-color: #1a252f;
    border-right: 3px solid #3498db;
    color: #3498db;
}
QPushButton[class="MenuButton"]:disabled { color: #7f8c8d; }

QPushButton#btnLogout {
    background-color: transparent;
    color: #e74c3c;
    border: none;
    border-top: 1px solid #34495e;
    padding: 12px 16px;
    text-align: left;
    font-weight: bold;
    font-size: 13px;
    min-height: 40px;
}
QPushButton#btnLogout:hover { background-color: #34495e; }

QPushButton {
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    min-height: 32px;
}
QPushButton:disabled { background-color: #bdc3c7; color: #7f8c8d; }

QPushButton[class="btn-primary"] { background-color: #3498db; color: white; }
QPushButton[class="btn-primary"]:hover { background-color: #2980b9; }
QPushButton[class="btn-success"] { background-color: #27ae60; color: white; }
QPushButton[class="btn-success"]:hover { background-color: #2ecc71; }
QPushButton[class="btn-warning"] { background-color: #f39c12; color: white; }
QPushButton[class="btn-warning"]:hover { background-color: #e67e22; }
QPushButton[class="btn-danger"] { background-color: #e74c3c; color: white; }
QPushButton[class="btn-danger"]:hover { background-color: #ef5350; }

QFrame[class="Card"] {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 12px;
}
QFrame[class="Card"]:hover { border-color: #3498db; }

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    gridline-color: #ecf0f1;
    padding: 4px;
}
QTableWidget::item { padding: 6px; }
QTableWidget::item:hover { background-color: #e8f0fe; }
QTableWidget::item:selected { background-color: #3498db; color: white; }
QHeaderView::section {
    background-color: #2c3e50;
    color: white;
    padding: 8px 12px;
    border: none;
    font-weight: bold;
}

QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    padding: 8px;
}
QTabBar::tab {
    padding: 10px 20px;
    font-weight: bold;
    background-color: #f1f2f6;
    border: 1px solid transparent;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    border-color: #dee2e6;
    border-bottom: 2px solid #3498db;
    color: #3498db;
}
QTabBar::tab:hover { background-color: #e2e8f0; }

QComboBox {
    padding: 6px 12px;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    background-color: #ffffff;
    min-height: 32px;
}
QComboBox:hover { border-color: #3498db; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #7f8c8d;
}

QLineEdit, QSpinBox, QDateEdit, QTextEdit {
    padding: 6px 12px;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    background-color: #ffffff;
    min-height: 32px;
}
QLineEdit:focus, QSpinBox:focus, QDateEdit:focus, QTextEdit:focus {
    border: 2px solid #3498db;
}

QScrollBar:vertical {
    background-color: #f1f2f6;
    width: 8px;
    border-radius: 4px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background-color: #bdc3c7;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background-color: #95a5a6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QLabel#NotificationBadge {
    background-color: #e74c3c;
    color: white;
    border-radius: 10px;
    font-weight: bold;
    font-size: 10px;
    padding: 0px;
}
QWidget#MainContainer { background-color: #f8f9fa; }
