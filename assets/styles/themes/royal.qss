/* تم royal برای PARTOW - رنگ سفید خالص استفاده نشده است */
QWidget {
    font-family: "Vazirmatn";
    font-size: 13px;
    color: #F4C542;
}
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #08223A, stop:0.35 #0B2E4F, stop:0.68 #174F78, stop:1 #08223A);
}
/* منوی سمت چپ در همه تم‌ها ثابت و آبی/طلایی است */
QFrame#MenuFrame { background-color: #0B2E4F; border: none; }
QPushButton[class="MenuButton"] { background-color: transparent; color: #F4C542; border: none; padding: 12px 16px; text-align: right; font-weight: 500; min-height: 40px; }
QPushButton[class="MenuButton"]:hover { background-color: #174F78; color: #FFE8A3; border-right: 3px solid #F4C542; }
QPushButton[class="MenuButton"]:checked, QPushButton[class="MenuButton"]:pressed { background-color: #08223A; color: #FFE8A3; border-right: 3px solid #F4C542; }
QPushButton[class="MenuButton"]:disabled { color: #D9C36A; background-color: transparent; }
QPushButton#btnLogout { background-color: #C62828; color: #111111; border: 1px solid #F28C28; padding: 12px 16px; font-weight: bold; }
QPushButton#btnLogout:hover { background-color: #F28C28; color: #111111; }
QPushButton { background-color: #174F78; color: #F4C542; border: 1px solid #D9C36A; border-radius: 6px; padding: 8px 16px; font-weight: 600; min-height: 32px; }
QPushButton:hover { background-color: #0B2E4F; color: #FFE8A3; }
QPushButton:disabled { background-color: #08223A; color: #D9C36A; border-color: #D9C36A; }
QPushButton[class="btn-primary"] { background-color: #174F78; color: #F4C542; border-color: #D9C36A; }
QPushButton[class="btn-primary"]:hover { background-color: #0B2E4F; color: #FFE8A3; }
QPushButton[class="btn-success"] { background-color: #66BB6A; color: #111111; border-color: #8BC34A; }
QPushButton[class="btn-success"]:hover { background-color: #8BC34A; color: #111111; }
QPushButton[class="btn-warning"] { background-color: #F4D35E; color: #C62828; border-color: #D9C36A; }
QPushButton[class="btn-warning"]:hover { background-color: #FFE8A3; color: #C62828; }
QPushButton[class="btn-danger"] { background-color: #F28C28; color: #111111; border-color: #F4D35E; }
QPushButton[class="btn-danger"]:hover { background-color: #C62828; color: #FFE8A3; }
QFrame[class="Card"], QGroupBox { background-color: #66BB6A; color: #111111; border: 1px solid #8BC34A; border-radius: 8px; padding: 10px; }
QFrame[class="Card"]:hover { background-color: #8BC34A; border-color: #F4C542; }
QGroupBox::title { color: #111111; background-color: #8BC34A; padding: 0 8px; }
QTableWidget, QTreeWidget { background-color: #08223A; color: #F4C542; border: 1px solid #D9C36A; border-radius: 6px; gridline-color: #D9C36A; selection-background-color: #66BB6A; selection-color: #F4C542; }
QTableWidget::item, QTreeWidget::item { background-color: #08223A; color: #F4C542; padding: 6px; border-bottom: 1px solid #D9C36A; }
QTableWidget::item:hover, QTreeWidget::item:hover { background-color: #174F78; color: #FFE8A3; }
QTableWidget::item:selected, QTreeWidget::item:selected { background-color: #66BB6A; color: #F4C542; }
QHeaderView::section, QTreeWidget::header { background-color: #66BB6A; color: #111111; padding: 8px 12px; border: 1px solid #D9C36A; font-weight: bold; }
QTreeWidget::branch { background-color: #08223A; }
QTabWidget::pane { background-color: #66BB6A; color: #111111; border: 1px solid #8BC34A; border-radius: 6px; padding: 8px; }
QTabBar::tab { background-color: #66BB6A; color: #111111; border: 1px solid #8BC34A; padding: 10px 20px; font-weight: bold; margin-right: 2px; }
QTabBar::tab:selected { background-color: #8BC34A; color: #111111; border-color: #F4C542; border-bottom: 2px solid #F4C542; }
QTabBar::tab:hover { background-color: #F4D35E; color: #111111; }
QComboBox, QLineEdit, QSpinBox, QDateEdit, QTextEdit { background-color: #08223A; color: #F4C542; border: 1px solid #8BC34A; border-radius: 6px; padding: 6px 12px; min-height: 32px; }
QComboBox:hover, QLineEdit:hover, QSpinBox:hover, QDateEdit:hover, QTextEdit:hover { background-color: #0B2E4F; color: #FFE8A3; border-color: #F4C542; }
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDateEdit:focus, QTextEdit:focus { background-color: #0B2E4F; color: #FFE8A3; border: 2px solid #F4C542; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: none; border-left: 5px solid transparent; border-right: 5px solid transparent; border-top: 6px solid #F4C542; }
QComboBox QAbstractItemView { background-color: #08223A; color: #F4C542; selection-background-color: #66BB6A; selection-color: #111111; border: 1px solid #D9C36A; }
QProgressBar { background-color: #08223A; color: #F4C542; border: 1px solid #D9C36A; border-radius: 5px; text-align: center; }
QProgressBar::chunk { background-color: #66BB6A; border-radius: 4px; }
QScrollBar:vertical, QScrollBar:horizontal { background-color: #08223A; border-radius: 4px; margin: 2px; }
QScrollBar:vertical { width: 8px; } QScrollBar:horizontal { height: 8px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background-color: #8BC34A; border-radius: 4px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background-color: #F4C542; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical, QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { height: 0px; width: 0px; }
QMessageBox, QMessageBox QWidget { background-color: #F4D35E; color: #C62828; }
QMessageBox QLabel { background-color: #F4D35E; color: #C62828; }
QMessageBox QPushButton { background-color: #F4D35E; color: #C62828; border: 1px solid #C62828; }
QLabel#NotificationBadge { background-color: #F4D35E; color: #C62828; border: 1px solid #C62828; border-radius: 10px; font-weight: bold; }
QToolTip { background-color: #F4D35E; color: #C62828; border: 1px solid #C62828; padding: 5px; }
QWidget#MainContainer { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #08223A, stop:0.35 #0B2E4F, stop:0.70 #174F78, stop:1 #08223A); }
